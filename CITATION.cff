    title: "Consumer Expenditures--2024"
    authors:
      - name: "U.S. Bureau of Labor Statistics"
    year: 2025
    url: "https://www.bls.gov/news.release/archives/cesan_12192025.pdf"
    notes: "USDL-25-1586, released 19 December 2025"
  - type: database
    title: "Consumer Price Index, CPI-U, US city average, annual averages"
    authors:
      - name: "U.S. Bureau of Labor Statistics"
    year: 2026
